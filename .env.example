# Supabase (server-only — service role key bypasses RLS, never expose to the client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# PayMongo (server-only)
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Base URL used to build PayMongo success/cancel redirect URLs
# Local dev: http://localhost:3000 (or whatever `vercel dev` prints)
# Production: your Vercel deployment URL
SITE_URL=

# Waitlist form target (Formspree). VITE_-prefixed = exposed to the client, baked in at build time.
VITE_FORMSPREE_ENDPOINT=
