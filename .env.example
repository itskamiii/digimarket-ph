# Supabase (server-only — service role key bypasses RLS, never expose to the client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# PayMongo (server-only)
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Base URL used to build PayMongo success/cancel redirect URLs
# Local dev: http://localhost:3000 (or whatever `vercel dev` prints)
# Production: your Vercel deployment URL
SITE_URL=

# Owner order-notification target (Formspree) — not used by the public site, only by
# server/notify.ts. Collection-drop subscribers go straight into the `subscribers` table
# instead (see api/subscribe.ts), not through Formspree.
VITE_FORMSPREE_ENDPOINT=

# Secures api/cron/layaway-reminders.ts — Vercel sends this as a Bearer token when it
# triggers the cron (see vercel.json). Any random string; not tied to an external account.
CRON_SECRET=
